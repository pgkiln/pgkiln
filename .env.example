# Owner connection: migrations, builder, SQL Workshop
DATABASE_URL=postgres://pgapex:pgapex@localhost:5434/pgapex
# Least-privilege connection used to run applications (see db/migrations/001_meta.sql)
RUNTIME_DATABASE_URL=postgres://pgapex_runtime:pgapex_runtime@localhost:5434/pgapex
PORT=3100
# The address users use to reach pgapex (used for single sign-on redirect URIs)
PUBLIC_URL=http://127.0.0.1:3100
# Set to true behind HTTPS
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=8
# REST API (PostgREST alongside pgapex; see docs/guide/13-rest-api.md)
API_URL=http://127.0.0.1:3000
# Shared with PostgREST (docker compose reads it from .env). At least 32 characters; CHANGE IT.
API_JWT_SECRET=dev-only-api-secret-change-me-0123456789abcdef
