# Owner connection: migrations, builder, SQL Workshop
DATABASE_URL=postgres://pgapex:pgapex@localhost:5434/pgapex
# Least-privilege connection used to run applications (see db/migrations/001_meta.sql)
RUNTIME_DATABASE_URL=postgres://pgapex_runtime:pgapex_runtime@localhost:5434/pgapex
PORT=3100
# The address users use to reach pgapex (used for single sign-on redirect URIs)
PUBLIC_URL=http://127.0.0.1:3100
# Set to true behind HTTPS
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=8
# REST API (PostgREST alongside pgapex; see docs/guide/13-rest-api.md)
API_URL=http://127.0.0.1:3000
# Shared with PostgREST (docker compose reads it from .env). At least 32 characters; CHANGE IT.
API_JWT_SECRET=dev-only-api-secret-change-me-0123456789abcdef
# Files (docs/guide/16-files.md)
MAX_UPLOAD_MB=10
DATA_LOAD_MAX_MB=50
# Optional TrueType fonts for report PDFs (text beyond Western European), e.g. DejaVuSans.ttf
# PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# PDF_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# LDAP sign-in: time limit per directory request (directories are set up in the builder: Users → LDAP directories)
LDAP_TIMEOUT_MS=5000
# Only for the tests (test/ldap.test.ts): the demo directory of docker compose --profile ldap
# LDAP_URL=ldap://127.0.0.1:3890
# Workflows: how often the server checks for waits that are over (it also reacts to NOTIFY at once);
# WORKFLOWS=off on servers that should not run them
WORKFLOW_INTERVAL_S=10
# Background execution chains (meta.process_job): how often a server checks for queued jobs (it also reacts
# to NOTIFY at once); BACKGROUND_PROCESSES=off on servers that should not run them
# BACKGROUND_PROCESSES=on
# PROCESS_JOB_INTERVAL_S=10

# Map regions: tile server (URL template) and its attribution. OpenStreetMap's public tiles suit light use only;
# see https://operations.osmfoundation.org/policies/tiles/. The CSP allows images from this server.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors

# REST data sources and web credentials (docs/guide/19-rest-data-sources.md). Outgoing calls are off until
# hosts are allowed; private/loopback addresses also need PGAPEX_REST_PRIVATE_HOSTS.
# PGAPEX_REST_ALLOWED_HOSTS=api.example.com,*.example.org
# PGAPEX_REST_PRIVATE_HOSTS=
# PGAPEX_REST_MAX_BYTES=5000000
# Encrypts web credential secrets (at least 32 characters, e.g. `openssl rand -base64 32`); keep it outside the database
# PGAPEX_SECRET_KEY=

# Large tables (docs/guide/04-pages-and-regions.md#large-tables): CSV/Excel download row limit, and the
# in-memory region cache (0 entries turns it off)
# DOWNLOAD_MAX_ROWS=1000000
# Statement timeout of SQL Workshop → Unload Data (PostgreSQL interval syntax)
# UNLOAD_STATEMENT_TIMEOUT=5min
# Rows in a report PDF (1 to 100000)
# PDF_MAX_ROWS=5000
# REGION_CACHE_MAX_ENTRIES=1000
# REGION_CACHE_MAX_MB=64

# HTTP header authentication (docs/guide/08-security.md): proxies whose user header is trusted (IPs or CIDRs)
# PGAPEX_AUTH_HEADER_PROXIES=10.0.0.5,192.168.1.0/24
