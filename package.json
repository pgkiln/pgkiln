{
  "name": "pgapex",
  "version": "0.17.0",
  "private": true,
  "description": "Open source low-code, SQL-driven application builder for PostgreSQL, inspired by Oracle APEX",
  "keywords": [
    "postgresql",
    "low-code",
    "apex",
    "oracle-apex",
    "plpgsql",
    "rad",
    "crud",
    "app-builder"
  ],
  "license": "Apache-2.0",
  "author": "Vargar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickVrgr/Postgresql_APEX.git"
  },
  "bugs": {
    "url": "https://github.com/NickVrgr/Postgresql_APEX/issues"
  },
  "homepage": "https://github.com/NickVrgr/Postgresql_APEX#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "pgapex": "bin/pgapex.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:up": "docker compose up -d db",
    "db:reset": "docker compose down -v && docker compose up -d db && tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "tsx scripts/migrate.ts --example hr",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "pgapex": "tsx src/cli/main.ts",
    "example:hr": "tsx scripts/migrate.ts --example hr",
    "setup": "docker compose up -d db && tsx scripts/migrate.ts",
    "pretest:e2e": "tsx scripts/migrate.ts --example hr",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@node-saml/node-saml": "^5.1.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "ldapts": "^9.2.0",
    "leaflet": "^1.9.4",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "xml-crypto": "^6.3.2"
  }
}
