{
  "name": "pgapex",
  "version": "0.3.0",
  "private": true,
  "description": "Open source low-code, SQL-driven application builder for PostgreSQL, inspired by Oracle APEX",
  "keywords": [
    "postgresql",
    "low-code",
    "apex",
    "oracle-apex",
    "plpgsql",
    "rad",
    "crud",
    "app-builder"
  ],
  "license": "Apache-2.0",
  "author": "Vargar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickVrgr/Postgresql_APEX.git"
  },
  "bugs": {
    "url": "https://github.com/NickVrgr/Postgresql_APEX/issues"
  },
  "homepage": "https://github.com/NickVrgr/Postgresql_APEX#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:up": "docker compose up -d db",
    "db:reset": "docker compose down -v && docker compose up -d db && tsx scripts/migrate.ts --seed",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/migrate.ts --seed",
    "setup": "docker compose up -d db && tsx scripts/migrate.ts --seed",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
