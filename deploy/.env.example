# pgkiln with Docker. Copy to .env, fill in the four required secrets, then: docker compose up -d
# Generate secrets with:  openssl rand -hex 24      (hex is safe inside database URLs)

# --- what to run --------------------------------------------------------------------
# db: the bundled PostgreSQL 17. Remove it to use your own server (set the two URLs below).
# Add ",https" for Caddy with an automatic certificate for PGKILN_DOMAIN.
COMPOSE_PROFILES=db

# --- required secrets ---------------------------------------------------------------
# owner of the bundled database
POSTGRES_PASSWORD=
# the least-privilege role that runs applications (set on every start)
RUNTIME_PASSWORD=
# encrypts stored secrets (web credentials, AI keys, push keys): 32+ characters.
# Keep it safe and out of database backups: without it those secrets are lost.
PGKILN_SECRET_KEY=
# replaces the builder's built-in admin / admin on the first start (12+ characters)
PGKILN_ADMIN_PASSWORD=

# --- your own PostgreSQL instead of the bundled one ----------------------------------
# DATABASE_URL=postgres://pgkiln:...@your-server:5432/yourdb
# RUNTIME_DATABASE_URL=postgres://pgkiln_runtime:...@your-server:5432/yourdb

# --- address -------------------------------------------------------------------------
# PGKILN_PORT=3100
# PGKILN_BIND=127.0.0.1       # 0.0.0.0: reachable from the network over plain HTTP
# With the https profile: your domain name (its DNS must point here; ports 80 and 443 open)
# PGKILN_DOMAIN=apps.example.com
# PUBLIC_URL=https://apps.example.com
# COOKIE_SECURE=true
# TRUST_PROXY=true

# --- optional ------------------------------------------------------------------------
# PGKILN_EXAMPLE=hr           # installs the HR example (demo users with weak passwords)
# PGKILN_IMAGE=pgkiln:local   # a published image instead of building one
# Any other setting of docs/guide/01-installation.md ("Configuration reference") can go here too.
